<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#151515">
  <meta name="description" content="TerminWerk unterstützt Unternehmen mit professioneller Terminierung, Vertriebsunterstützung und Callcenter-Dienstleistungen.">
  <title>TerminWerk – Kundenkommunikation mit Struktur</title>
  <style>
    :root {
      --ink: #151515;
      --ink-2: #222326;
      --paper: #ffffff;
      --soft: #f4f4f5;
      --line: #e2e2e5;
      --muted: #65666b;
      --red: #d8293f;
      --red-dark: #b91f32;
      --radius: 18px;
      --shadow: 0 18px 55px rgba(15, 15, 18, .10);
      --max: 1180px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body { margin: 0; color: var(--ink); background: var(--paper); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    button, input, select, textarea { font: inherit; }
    .container { width: min(var(--max), calc(100% - 44px)); margin-inline: auto; }
    .eyebrow { display: inline-flex; align-items: center; gap: 10px; text-transform: uppercase; letter-spacing: .16em; font-size: .76rem; font-weight: 800; }
    .eyebrow::before { content: ""; width: 26px; height: 3px; border-radius: 3px; background: var(--red); }
    h1, h2, h3, p { margin-top: 0; }
    h1 { font-size: clamp(2.8rem, 6.2vw, 5.65rem); line-height: .99; letter-spacing: -.065em; max-width: 760px; margin: 22px 0; }
    h2 { font-size: clamp(2rem, 4vw, 3.35rem); line-height: 1.06; letter-spacing: -.045em; margin: 16px 0 18px; }
    h3 { line-height: 1.2; letter-spacing: -.02em; }
    .lead { font-size: clamp(1.05rem, 1.5vw, 1.2rem); color: #d4d4d6; max-width: 610px; }
    .section { padding: 100px 0; }
    .section-head { max-width: 720px; margin-bottom: 42px; }
    .section-head p { color: var(--muted); max-width: 620px; margin-bottom: 0; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; padding: 14px 20px; border-radius: 999px; border: 1px solid transparent; font-weight: 750; font-size: .94rem; transition: transform .18s ease, background .18s ease, border-color .18s ease; cursor: pointer; }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary { background: var(--red); color: #fff; box-shadow: 0 9px 22px rgba(216, 41, 63, .22); }
    .btn-primary:hover { background: var(--red-dark); }
    .btn-light { background: #fff; color: var(--ink); }
    .btn-light:hover { background: #f2f2f2; }
    .btn-outline { color: #fff; border-color: rgba(255,255,255,.38); background: transparent; }
    .btn-outline:hover { border-color: #fff; background: rgba(255,255,255,.08); }
    .arrow { font-size: 1.15rem; line-height: 1; }

    /* Header */
    .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.95); border-bottom: 1px solid rgba(20,20,20,.08); backdrop-filter: blur(14px); }
    .nav-wrap { display: flex; align-items: center; justify-content: space-between; min-height: 78px; gap: 22px; }
    .brand { display: inline-flex; align-items: center; gap: 11px; flex-shrink: 0; }
    .brand-mark { width: 42px; height: 42px; background: var(--red); color: white; display: grid; place-items: center; font-weight: 950; letter-spacing: -.12em; font-size: 1.03rem; border-radius: 12px 12px 12px 4px; transform: skew(-3deg); }
    .brand-name { font-size: 1.35rem; font-weight: 850; letter-spacing: -.055em; line-height: 1; }
    .brand-name span { color: var(--red); }
    .brand-tag { display: block; margin-top: 5px; color: #66676b; font-size: .56rem; font-weight: 750; text-transform: uppercase; letter-spacing: .14em; }
    .nav-links { display: flex; align-items: center; gap: clamp(14px, 2.1vw, 30px); }
    .nav-links a:not(.btn) { font-size: .9rem; font-weight: 650; color: #3f4043; transition: color .2s; }
    .nav-links a:not(.btn):hover, .nav-links a.active { color: var(--red); }
    .nav-cta { padding: 11px 16px; }
    .menu-toggle { display: none; border: 0; background: transparent; font-size: 1.8rem; cursor: pointer; }

    /* Hero */
    .hero { position: relative; overflow: hidden; background: var(--ink); color: #fff; min-height: 620px; display: flex; align-items: center; }
    .hero::before { content: ""; position: absolute; width: 580px; height: 580px; right: -200px; top: -220px; border: 1px solid rgba(216,41,63,.5); border-radius: 50%; box-shadow: 0 0 0 45px rgba(216,41,63,.035), 0 0 0 95px rgba(216,41,63,.025); }
    .hero::after { content: ""; position: absolute; right: 0; bottom: 0; width: 36%; height: 5px; background: var(--red); }
    .hero-grid { display: grid; grid-template-columns: 1.08fr .92fr; gap: 34px; align-items: center; padding: 74px 0 82px; position: relative; z-index: 1; }
    .hero h1 .red-word { color: var(--red); }
    .hero-copy .eyebrow { color: #dedee0; }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
    .hero-proof { margin-top: 42px; display: flex; flex-wrap: wrap; gap: 20px 25px; color: #e1e1e3; font-size: .88rem; }
    .proof-item { display: flex; align-items: center; gap: 9px; }
    .proof-icon { color: var(--red); font-weight: 900; font-size: 1.2rem; }
    .hero-visual { position: relative; min-height: 420px; display: flex; align-items: center; justify-content: center; }
    .hero-photo { position: absolute; inset: 12px 0 12px 24px; border-radius: 180px 20px 20px 20px; overflow: hidden; background: linear-gradient(135deg, #45464a, #1b1b1e 55%, #70212b); }
    .hero-photo img { width: 100%; height: 100%; object-fit: cover; opacity: .66; filter: grayscale(100%); }
    .hero-photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(13,13,15,.85), rgba(13,13,15,.02) 65%), linear-gradient(90deg, rgba(216,41,63,.16), transparent 65%); }
    .visual-note { position: absolute; left: 0; bottom: 0; max-width: 260px; padding: 22px 24px; border-left: 4px solid var(--red); background: #fff; color: var(--ink); border-radius: 0 14px 14px 0; box-shadow: var(--shadow); }
    .visual-note strong { display: block; font-size: 1.14rem; line-height: 1.2; margin-bottom: 5px; }
    .visual-note span { display: block; color: #66676b; font-size: .88rem; }
    .visual-stamp { position: absolute; right: -12px; top: 0; width: 98px; height: 98px; border-radius: 50%; display: grid; place-items: center; text-align: center; border: 1px solid rgba(255,255,255,.45); background: var(--red); color: white; font-size: .68rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 850; line-height: 1.45; transform: rotate(8deg); }

    /* Trust strip */
    .trust-strip { background: var(--soft); border-bottom: 1px solid var(--line); }
    .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
    .trust-item { padding: 25px 26px; display: flex; align-items: center; gap: 15px; border-right: 1px solid #dedee1; }
    .trust-item:first-child { padding-left: 0; }
    .trust-item:last-child { border: 0; }
    .trust-icon { display: grid; place-items: center; width: 44px; height: 44px; flex: 0 0 44px; background: white; border: 1px solid var(--line); color: var(--red); border-radius: 13px; font-size: 1.22rem; font-weight: 900; }
    .trust-item strong { display: block; font-size: .96rem; }
    .trust-item span { display: block; color: var(--muted); font-size: .84rem; }

    /* About */
    .about-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 75px; align-items: center; }
    .about-art { position: relative; min-height: 450px; background: var(--ink); border-radius: 22px; overflow: hidden; padding: 32px; color: #fff; display: flex; align-items: flex-end; }
    .about-art::before { content: "TW"; position: absolute; top: -66px; left: 6px; color: rgba(255,255,255,.055); font-size: 18rem; font-weight: 950; letter-spacing: -.12em; line-height: 1; }
    .about-art::after { content: ""; position: absolute; height: 6px; width: 95px; background: var(--red); top: 36px; left: 32px; }
    .about-art-content { position: relative; z-index: 1; }
    .about-art-content .big-line { font-size: clamp(2rem, 4vw, 3.3rem); font-weight: 850; letter-spacing: -.06em; line-height: 1.03; max-width: 350px; }
    .about-art-content p { margin: 16px 0 0; color: #c9c9cc; max-width: 330px; }
    .about-copy > p { color: var(--muted); }
    .value-list { list-style: none; padding: 0; margin: 28px 0 30px; display: grid; gap: 17px; }
    .value-list li { display: grid; grid-template-columns: 28px 1fr; gap: 12px; }
    .check { display: grid; place-items: center; width: 26px; height: 26px; background: #fff0f2; color: var(--red); border-radius: 8px; font-weight: 900; }
    .value-list strong { display: block; margin-bottom: 2px; }
    .value-list span { color: var(--muted); font-size: .93rem; }

    /* Services */
    .services-section { background: var(--soft); }
    .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .service-card { background: #fff; padding: 28px; border: 1px solid var(--line); border-radius: var(--radius); transition: transform .2s, box-shadow .2s, border-color .2s; }
    .service-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); border-color: #f1a0aa; }
    .service-number { display: flex; align-items: center; justify-content: space-between; color: var(--red); font-weight: 850; font-size: .78rem; letter-spacing: .12em; }
    .service-icon { width: 55px; height: 55px; background: var(--ink); color: #fff; display: grid; place-items: center; border-radius: 16px; font-size: 1.45rem; margin: 28px 0 20px; }
    .service-card h3 { font-size: 1.35rem; margin-bottom: 10px; }
    .service-card p { color: var(--muted); font-size: .94rem; }
    .text-link { display: inline-flex; align-items: center; gap: 8px; font-size: .9rem; font-weight: 800; color: var(--red); }
    .text-link:hover { gap: 12px; }

    /* Industries */
    .industry-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .industry-card { position: relative; min-height: 225px; overflow: hidden; padding: 21px; border-radius: 16px; background: #202124; color: #fff; display: flex; flex-direction: column; justify-content: flex-end; isolation: isolate; }
    .industry-card::before { content: ""; position: absolute; inset: 0; z-index: -2; opacity: .5; background: radial-gradient(circle at 75% 18%, #a9a9ac, transparent 35%), linear-gradient(135deg, #3b3c41, #141416 70%); }
    .industry-card::after { content: ""; position: absolute; z-index: -1; inset: 0; background: linear-gradient(0deg, rgba(10,10,12,.96), rgba(10,10,12,.12) 90%); }
    .industry-symbol { position: absolute; top: 21px; right: 22px; color: #fff; opacity: .9; font-size: 1.8rem; }
    .industry-card h3 { margin: 0 0 6px; font-size: 1.14rem; }
    .industry-card p { margin: 0; font-size: .86rem; color: #d8d8da; }
    .industry-note { margin-top: 20px; color: var(--muted); font-size: .92rem; }

    /* People */
    .people-section { background: var(--ink); color: #fff; overflow: hidden; }
    .people-section .section-head p { color: #c4c4c7; }
    .people-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
    .person-card { position: relative; display: grid; grid-template-columns: .9fr 1.1fr; min-height: 255px; overflow: hidden; background: #232326; border: 1px solid rgba(255,255,255,.12); border-radius: 18px; }
    .portrait-placeholder { min-height: 255px; display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #e9e9ea, #bfc0c3); color: #1c1c1e; position: relative; overflow: hidden; }
    .portrait-placeholder::before { content: ""; position: absolute; width: 175px; height: 175px; border: 1px solid rgba(20,20,20,.18); border-radius: 50%; }
    .portrait-placeholder::after { content: ""; position: absolute; width: 220px; height: 220px; border: 1px solid rgba(20,20,20,.13); border-radius: 50%; }
    .portrait-initials { position: relative; z-index: 1; font-size: 3rem; font-weight: 900; letter-spacing: -.08em; }
    .person-info { padding: 27px 24px; display: flex; flex-direction: column; justify-content: center; }
    .person-info .eyebrow { color: #c9c9cb; font-size: .65rem; }
    .person-info h3 { margin: 12px 0 5px; font-size: 1.35rem; }
    .person-info p { color: #c4c4c7; font-size: .9rem; margin-bottom: 0; }
    .portrait-tag { margin-top: 15px; display: inline-flex; align-self: flex-start; padding: 5px 9px; border-radius: 6px; background: rgba(216,41,63,.17); color: #ffb0bb; font-size: .72rem; font-weight: 750; }

    /* Careers */
    .career-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 55px; align-items: start; }
    .career-copy p { color: var(--muted); }
    .benefit-list { display: grid; gap: 14px; margin: 28px 0 0; }
    .benefit { display: flex; align-items: flex-start; gap: 12px; }
    .benefit .check { flex-shrink: 0; }
    .benefit strong { display: block; }
    .benefit span:not(.check) { color: var(--muted); font-size: .88rem; }
    .form-card { padding: 31px; background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow); }
    .form-card h3 { font-size: 1.5rem; margin-bottom: 6px; }
    .form-card .form-intro { color: var(--muted); font-size: .93rem; margin-bottom: 23px; }
    .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
    .field.full { grid-column: 1 / -1; }
    .field label { font-size: .83rem; font-weight: 750; }
    .field input, .field select, .field textarea { width: 100%; min-width: 0; border: 1px solid #dadadd; border-radius: 10px; background: #fbfbfc; padding: 12px 13px; color: var(--ink); outline: none; transition: border-color .2s, box-shadow .2s; }
    .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--red); box-shadow: 0 0 0 3px rgba(216,41,63,.1); }
    .field textarea { min-height: 105px; resize: vertical; }
    .field small { color: var(--muted); font-size: .78rem; }
    .file-input { border-style: dashed !important; background: #fff !important; }
    .consent { display: flex; align-items: flex-start; gap: 9px; color: var(--muted); font-size: .8rem; margin: 17px 0; }
    .consent input { margin-top: 4px; accent-color: var(--red); }
    .consent a { text-decoration: underline; text-underline-offset: 2px; }
    .form-notice { color: var(--muted); font-size: .77rem; margin: 12px 0 0; }
    .submit-btn { width: 100%; }

    /* CTA and contact */
    .cta-band { background: var(--red); color: #fff; padding: 54px 0; }
    .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; }
    .cta-inner h2 { font-size: clamp(1.8rem, 3.2vw, 2.7rem); margin: 0 0 8px; }
    .cta-inner p { margin: 0; color: rgba(255,255,255,.85); }
    .contact-section { background: var(--soft); }
    .contact-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 55px; align-items: start; }
    .contact-details { display: grid; gap: 14px; margin-top: 28px; }
    .contact-row { display: flex; align-items: flex-start; gap: 13px; padding: 15px; background: #fff; border: 1px solid var(--line); border-radius: 13px; }
    .contact-row .trust-icon { flex-shrink: 0; }
    .contact-row strong { display: block; font-size: .92rem; }
    .contact-row span, .contact-row a { color: var(--muted); font-size: .89rem; overflow-wrap: anywhere; }
    .contact-row a:hover { color: var(--red); }
    .contact-form { padding: 29px; background: #fff; border: 1px solid var(--line); border-radius: 22px; }
    .contact-form h3 { font-size: 1.45rem; }

    /* Footer */
    .footer { background: #111112; color: #fff; padding: 55px 0 23px; }
    .footer-top { display: grid; grid-template-columns: 1.1fr .9fr .8fr; gap: 40px; padding-bottom: 35px; }
    .footer .brand-tag { color: #a6a6aa; }
    .footer-blurb { margin-top: 20px; max-width: 330px; color: #b9b9bd; font-size: .9rem; }
    .footer h3 { font-size: .86rem; text-transform: uppercase; letter-spacing: .13em; color: #fff; margin-bottom: 16px; }
    .footer-links { display: grid; gap: 9px; color: #c4c4c7; font-size: .88rem; }
    .footer-links a:hover { color: #ff8a99; }
    .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 20px; border-top: 1px solid #303033; color: #a9a9ad; font-size: .78rem; }
    .legal-note { margin-top: 18px; color: #a9a9ad; font-size: .78rem; }

    /* WhatsApp badge */
    .whatsapp-float { position: fixed; z-index: 60; right: 22px; bottom: 22px; display: inline-flex; align-items: center; gap: 11px; padding: 12px 15px 12px 12px; color: #fff; background: #25D366; border-radius: 999px; box-shadow: 0 10px 30px rgba(0,0,0,.22); font-weight: 800; font-size: .9rem; transition: transform .18s, box-shadow .18s; }
    .whatsapp-float:hover { transform: translateY(-3px); box-shadow: 0 14px 35px rgba(0,0,0,.28); }
    .whatsapp-icon { width: 29px; height: 29px; display: block; flex-shrink: 0; }
    .form-success { padding: 12px 14px; margin-top: 12px; color: #126b36; background: #e9f9ef; border-radius: 9px; display: none; font-size: .9rem; }
    .honeypot { position: absolute !important; left: -5000px !important; width: 1px !important; height: 1px !important; overflow: hidden !important; }

    @media (max-width: 1020px) {
      .nav-links { gap: 14px; }
      .nav-links a:not(.btn) { font-size: .82rem; }
      .brand-name { font-size: 1.2rem; }
      .hero-grid { grid-template-columns: 1fr .82fr; }
      .hero-visual { min-height: 360px; }
      .about-grid { gap: 45px; }
      .industry-grid { grid-template-columns: repeat(2, 1fr); }
      .person-card { grid-template-columns: .8fr 1.2fr; }
    }
    @media (max-width: 800px) {
      .container { width: min(var(--max), calc(100% - 32px)); }
      .section { padding: 74px 0; }
      .nav-wrap { min-height: 70px; }
      .menu-toggle { display: block; }
      .nav-links { display: none; position: absolute; left: 0; right: 0; top: 70px; padding: 18px 22px 24px; background: #fff; border-bottom: 1px solid var(--line); box-shadow: 0 18px 25px rgba(0,0,0,.08); align-items: stretch; flex-direction: column; gap: 0; }
      .nav-links.open { display: flex; }
      .nav-links a:not(.btn) { padding: 13px 0; border-bottom: 1px solid #eee; font-size: .96rem; }
      .nav-links .nav-cta { margin-top: 14px; }
      .hero-grid { grid-template-columns: 1fr; gap: 30px; padding: 63px 0 74px; }
      .hero { min-height: auto; }
      .hero-visual { min-height: 340px; width: min(100%, 520px); }
      .hero-photo { inset: 0 0 10px 20px; }
      .visual-stamp { right: -3px; }
      .trust-grid { grid-template-columns: 1fr; }
      .trust-item, .trust-item:first-child { padding: 18px 0; border-right: 0; border-bottom: 1px solid #dedee1; }
      .trust-item:last-child { border-bottom: 0; }
      .about-grid, .career-grid, .contact-grid { grid-template-columns: 1fr; gap: 35px; }
      .about-art { min-height: 320px; }
      .service-grid { grid-template-columns: 1fr; }
      .service-card { padding: 25px; }
      .people-grid { grid-template-columns: 1fr; }
      .footer-top { grid-template-columns: 1fr 1fr; }
      .footer-top > div:first-child { grid-column: 1 / -1; }
    }
    @media (max-width: 520px) {
      h1 { font-size: clamp(2.8rem, 13vw, 4rem); }
      .hero-actions { align-items: stretch; flex-direction: column; }
      .hero-actions .btn { width: 100%; }
      .hero-proof { display: grid; gap: 12px; }
      .hero-visual { min-height: 285px; }
      .visual-note { max-width: 220px; padding: 16px; }
      .visual-stamp { width: 82px; height: 82px; font-size: .58rem; right: -2px; }
      .industry-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
      .industry-card { min-height: 185px; padding: 15px; }
      .industry-card h3 { font-size: 1rem; }
      .industry-card p { font-size: .78rem; }
      .person-card { grid-template-columns: 1fr; }
      .portrait-placeholder { min-height: 215px; }
      .person-info { padding: 23px; }
      .form-card, .contact-form { padding: 22px 17px; }
      .form-grid { grid-template-columns: 1fr; }
      .field.full { grid-column: auto; }
      .cta-inner { align-items: flex-start; flex-direction: column; }
      .footer-top { grid-template-columns: 1fr; gap: 30px; }
      .footer-top > div:first-child { grid-column: auto; }
      .footer-bottom { align-items: flex-start; flex-direction: column; }
      .whatsapp-float { right: 14px; bottom: 14px; padding: 10px; }
      .whatsapp-float .wa-label { display: none; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition-duration: .01ms !important; } }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container nav-wrap">
      <a href="#start" class="brand" aria-label="TerminWerk Startseite">
        <span class="brand-mark">TW</span>
        <span><span class="brand-name">Termin<span>Werk</span></span><span class="brand-tag">Mehr Klarheit. Mehr Wirkung.</span></span>
      </a>
      <button class="menu-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-nav">☰</button>
      <nav class="nav-links" id="main-nav" aria-label="Hauptnavigation">
        <a class="active" href="#start">Startseite</a>
        <a href="#ueber-uns">Über uns</a>
        <a href="#leistungen">Leistungen</a>
        <a href="#projekte">Branchen</a>
        <a href="#karriere">Karriere</a>
        <a href="#kontakt">Kontakt</a>
        <a class="btn btn-primary nav-cta" href="#kontakt">Projekt besprechen <span class="arrow">↗</span></a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" id="start">
      <div class="container hero-grid">
